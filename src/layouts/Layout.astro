---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Douglas Schoch — Web GIS & Software Developer",
  description = "Portfolio of Douglas Schoch. Topographic trail maps, historical cartography, spatial analytics, and interactive Web GIS applications."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="Web GIS, Geospatial Developer, MapLibre GL, Leaflet, GTFS-Realtime, Python, Hydrology, Spatial Data Pipelines, 3D Cartography, Digital Humanities, NLP, Cartography" />
    <meta name="author" content="Douglas Schoch" />

    <!-- Open Graph / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/bustang_live_dashboard.jpg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <script is:inline>
      // Initialize dark mode from localStorage or system preference
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();

      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 font-sans transition-colors duration-200 min-h-screen flex flex-col selection:bg-emerald-500 selection:text-white">
    <slot />
  </body>
</html>

<style is:global>
  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  code, pre {
    font-family: 'JetBrains Mono', monospace;
  }
</style>
