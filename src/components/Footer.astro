---
interface Props {
  name?: string;
}

const { name = "Douglas Schoch" } = Astro.props;
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto bg-white dark:bg-slate-950 border-t border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-xs py-10 transition-colors">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
    
    <!-- Left: Copyright & Title -->
    <div class="text-center md:text-left">
      <div class="font-semibold text-slate-800 dark:text-slate-200 text-sm">
        {name}
      </div>
      <p class="mt-1">
        © {currentYear}. Hosted on GitHub Pages.
      </p>
    </div>

    <!-- Center / Right: Links -->
    <div class="flex flex-wrap items-center justify-center gap-6 font-medium">
      <a href="#projects" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Projects</a>
      <a href="/bustang_leaflet/" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">Bustang Tracker</a>
      <a href="#about" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">About</a>
      <a href="https://github.com/schochdo" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition-colors">GitHub</a>
    </div>

  </div>
</footer>
