---
interface Project {
  id: string;
  data: {
    title: string;
    date?: Date;
    tags?: string[];
    featured: boolean;
    order: number;
    summary: string;
    techStack?: string;
    category?: string;
    thumbnail?: string;
    heroImage?: string;
    liveUrl?: string;
    githubUrl?: string;
  };
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

// Sort projects by order
const sortedProjects = [...projects].sort((a, b) => (a.data.order || 99) - (b.data.order || 99));
---

<section id="projects" class="pt-6 pb-16 sm:pt-8 sm:pb-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="max-w-3xl mb-6 sm:mb-8">
    <div class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-1">
      <span>🗺️</span> Portfolio
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">
      Featured Projects
    </h2>
    <p class="text-slate-600 dark:text-slate-400 mt-1 text-xs sm:text-sm leading-relaxed">
      Interactive web maps, real-time data streaming, and web tools.
    </p>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-7" id="projects-grid">
    {sortedProjects.map(project => {
      const highRes = project.data.heroImage || project.data.thumbnail;

      return (
        <article class="project-card group rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-xl dark:hover:shadow-emerald-950/20 transition-all duration-300 flex flex-col">
          <!-- Image Box (click to open high-res lightbox) -->
          <div
            class="relative aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 cursor-pointer group/img"
            data-lightbox-trigger={highRes}
            data-lightbox-title={project.data.title}
            data-lightbox-desc={project.data.summary}
            role="button"
            tabindex="0"
            aria-label={`View map for ${project.data.title}`}
          >
            {project.data.thumbnail && (
              <img
                src={project.data.thumbnail}
                alt={project.data.title}
                loading="lazy"
                class="w-full h-full object-cover object-top transition-transform duration-300 group-hover:scale-102"
              />
            )}
          </div>

          <!-- Content Details -->
          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
            <div>
              <!-- Tech Stack Line -->
              {project.data.techStack && (
                <div class="text-xs font-mono font-medium text-emerald-600 dark:text-emerald-400 mb-2 tracking-tight">
                  {project.data.techStack}
                </div>
              )}

              <!-- Title -->
              <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight mb-2.5 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                {project.data.title}
              </h3>

              <!-- Summary -->
              <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                {project.data.summary}
              </p>
            </div>

            <!-- Action buttons -->
            <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-3 text-xs font-semibold">
              <div class="flex items-center gap-2">
                {project.data.liveUrl && (
                  <a
                    href={project.data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold transition-colors flex items-center gap-1.5 shadow-sm shadow-emerald-600/20"
                  >
                    <span>Launch Live App</span>
                    <span>↗</span>
                  </a>
                )}
              </div>

              {project.data.githubUrl && (
                <a
                  href={project.data.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors"
                  title="Source Code"
                >
                  GitHub
                </a>
              )}
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>
