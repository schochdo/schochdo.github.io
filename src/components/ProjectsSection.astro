---
interface Project {
  id: string;
  data: {
    title: string;
    date?: Date;
    tags: string[];
    featured: boolean;
    order: number;
    summary: string;
    category?: string;
    thumbnail?: string;
    heroImage?: string;
    liveUrl?: string;
    githubUrl?: string;
  };
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;

// Sort projects by order
const sortedProjects = [...projects].sort((a, b) => (a.data.order || 99) - (b.data.order || 99));

const categories = [
  { id: 'all', label: 'All Applications' },
  { id: 'environmental', label: '🌊 Environmental & Water' },
  { id: 'real-time', label: '⚡ Real-Time Transit' },
  { id: 'spatial-humanities', label: '🏛️ Spatial Humanities' },
  { id: 'digital-humanities', label: '📖 Digital Humanities' },
];

function getCategoryBadge(cat?: string) {
  switch (cat) {
    case 'environmental':
      return { label: 'Environmental & Water', icon: '🌊', color: 'bg-sky-50 dark:bg-sky-950/60 text-sky-700 dark:text-sky-300 border-sky-200 dark:border-sky-800/60' };
    case 'real-time':
      return { label: 'Real-Time Transit', icon: '⚡', color: 'bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border-emerald-200 dark:border-emerald-800/60' };
    case 'spatial-humanities':
      return { label: 'Spatial Humanities', icon: '🏛️', color: 'bg-violet-50 dark:bg-violet-950/60 text-violet-700 dark:text-violet-300 border-violet-200 dark:border-violet-800/60' };
    case 'digital-humanities':
      return { label: 'Digital Humanities & NLP', icon: '📖', color: 'bg-amber-50 dark:bg-amber-950/60 text-amber-700 dark:text-amber-300 border-amber-200 dark:border-amber-800/60' };
    default:
      return { label: 'Interactive Application', icon: '🗺️', color: 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700' };
  }
}
---

<section id="projects" class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
    <div>
      <div class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-2">
        <span>🗺️</span> Curated Portfolio
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Interactive Applications & Spatial Systems
      </h2>
      <p class="text-slate-600 dark:text-slate-400 mt-2 max-w-2xl text-sm sm:text-base">
        A multidisciplinary showcase bridging environmental water telemetry, real-time data streaming, interactive 3D cartography, and digital humanities.
      </p>
    </div>

    <!-- Domain Category Tabs -->
    <div class="flex flex-wrap gap-2 text-xs font-semibold" id="project-filters">
      {categories.map((cat, idx) => (
        <button
          data-category={cat.id}
          class={`category-tab px-3.5 py-1.5 rounded-xl border transition-all cursor-pointer ${
            idx === 0
              ? 'active bg-emerald-600 text-white border-emerald-600 shadow-xs'
              : 'bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-slate-700 hover:border-emerald-500 dark:hover:border-emerald-500'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="projects-grid">
    {sortedProjects.map(project => {
      const tagSlugs = (project.data.tags || []).map(t => t.toLowerCase().replace(/\s+/g, '-')).join(' ');
      const categorySlug = project.data.category || 'all';
      const highRes = project.data.heroImage || project.data.thumbnail;
      const catBadge = getCategoryBadge(project.data.category);

      return (
        <article
          data-category={categorySlug}
          data-tags={tagSlugs}
          class="project-card group rounded-2xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 overflow-hidden shadow-sm hover:shadow-xl dark:hover:shadow-emerald-950/20 transition-all duration-300 flex flex-col"
        >
          <!-- Image or Styled Placeholder Box -->
          <div class="relative aspect-[16/10] overflow-hidden bg-slate-100 dark:bg-slate-950 border-b border-slate-200 dark:border-slate-800 cursor-pointer group/img">
            {project.data.thumbnail ? (
              <img
                src={project.data.thumbnail}
                alt={project.data.title}
                loading="lazy"
                class="w-full h-full object-cover object-center group-hover/img:scale-105 transition-transform duration-500"
              />
            ) : (
              <div class="w-full h-full flex flex-col items-center justify-center p-6 bg-gradient-to-br from-slate-800 to-slate-950 text-slate-300 text-center relative overflow-hidden">
                <div class="w-16 h-16 rounded-2xl bg-white/10 border border-white/15 flex items-center justify-center text-3xl mb-3 shadow-inner">
                  {catBadge.icon}
                </div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-1">
                  {catBadge.label}
                </span>
                <span class="text-sm font-bold text-white max-w-xs line-clamp-2">
                  {project.data.title}
                </span>
              </div>
            )}

            <!-- Domain Badge Overlay -->
            <div class="absolute top-3.5 left-3.5 z-10">
              <span class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold border backdrop-blur-md shadow-xs ${catBadge.color}`}>
                <span>{catBadge.icon}</span>
                <span>{catBadge.label}</span>
              </span>
            </div>

            <!-- Hover overlay with Zoom button -->
            {highRes && (
              <button
                type="button"
                data-lightbox-trigger={highRes}
                data-lightbox-title={project.data.title}
                data-lightbox-desc={project.data.summary}
                aria-label={`View full resolution map for ${project.data.title}`}
                class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover/img:opacity-100 transition-opacity flex items-center justify-center gap-2 text-white font-medium text-sm backdrop-blur-[2px]"
              >
                <span class="px-4 py-2 rounded-xl bg-slate-900/90 text-white border border-white/20 shadow-lg flex items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  Inspect High-Res View
                </span>
              </button>
            )}
          </div>

          <!-- Content Details -->
          <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between">
            <div>
              <!-- Tags -->
              <div class="flex flex-wrap gap-1.5 mb-3">
                {(project.data.tags || []).map(tag => (
                  <span class="px-2.5 py-0.5 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-medium">
                    {tag}
                  </span>
                ))}
              </div>

              <!-- Title -->
              <h3 class="text-xl font-bold text-slate-900 dark:text-white tracking-tight mb-2.5 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors">
                {project.data.title}
              </h3>

              <!-- Summary -->
              <p class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-6">
                {project.data.summary}
              </p>
            </div>

            <!-- Action buttons -->
            <div class="pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between gap-3 text-xs font-semibold">
              <div class="flex items-center gap-2">
                {highRes && (
                  <button
                    type="button"
                    data-lightbox-trigger={highRes}
                    data-lightbox-title={project.data.title}
                    data-lightbox-desc={project.data.summary}
                    class="px-3.5 py-2 rounded-lg bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 hover:bg-emerald-100 dark:hover:bg-emerald-900/60 border border-emerald-200 dark:border-emerald-800/50 transition-colors flex items-center gap-1.5 cursor-pointer"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <circle cx="11" cy="11" r="8"></circle>
                      <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    </svg>
                    High-Res View
                  </button>
                )}

                {project.data.liveUrl && (
                  <a
                    href={project.data.liveUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="px-3.5 py-2 rounded-lg bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:bg-slate-800 dark:hover:bg-slate-100 transition-colors flex items-center gap-1.5"
                  >
                    <span>Launch Live App</span>
                    <span>↗</span>
                  </a>
                )}
              </div>

              {project.data.githubUrl && (
                <a
                  href={project.data.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-slate-500 hover:text-slate-900 dark:hover:text-white transition-colors"
                  title="Source Code"
                >
                  GitHub
                </a>
              )}
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<script>
  // Domain tab filter logic
  const categoryTabs = document.querySelectorAll<HTMLButtonElement>('.category-tab');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  categoryTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      categoryTabs.forEach(t => {
        t.classList.remove('active', 'bg-emerald-600', 'text-white', 'border-emerald-600', 'shadow-xs');
        t.classList.add('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');
      });

      tab.classList.add('active', 'bg-emerald-600', 'text-white', 'border-emerald-600', 'shadow-xs');
      tab.classList.remove('bg-white', 'dark:bg-slate-800', 'text-slate-700', 'dark:text-slate-300', 'border-slate-200', 'dark:border-slate-700');

      const selectedCat = tab.getAttribute('data-category') || 'all';

      projectCards.forEach(card => {
        const cardCat = card.getAttribute('data-category') || '';
        if (selectedCat === 'all' || cardCat === selectedCat) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });
</script>
