---
interface Props {
  profile: {
    name: string;
    headline: string;
    tagline: string;
    avatar?: string;
    github?: string;
    email?: string;
    website?: string;
  };
}

const { profile } = Astro.props;
---

<section class="relative overflow-hidden pt-10 pb-8 sm:pt-12 sm:pb-10 md:pt-14 md:pb-10 bg-gradient-to-b from-slate-100/70 via-slate-50 to-white dark:from-slate-900/60 dark:via-slate-950 dark:to-slate-950 border-b border-slate-200/60 dark:border-slate-850">
  <!-- Subtle decorative grid pattern background -->
  <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.06] pointer-events-none" style="background-image: radial-gradient(circle at 1px 1px, currentColor 1px, transparent 0); background-size: 32px 32px;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
    <div class="flex flex-col-reverse md:flex-row items-center gap-6 md:gap-10">
      
      <!-- Text & Intro Column -->
      <div class="flex-1 text-center md:text-left">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-slate-900 dark:text-white tracking-tight leading-tight mb-2 sm:mb-2.5">
          {profile.name}
        </h1>

        <p class="text-lg sm:text-xl font-medium text-emerald-600 dark:text-emerald-400 mb-2 sm:mb-3">
          {profile.headline}
        </p>

        <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 max-w-2xl mb-5 sm:mb-6 leading-relaxed">
          {profile.tagline}
        </p>


        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
          <a
            href="#projects"
            class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs sm:text-sm shadow-md shadow-emerald-600/20 hover:shadow-emerald-600/35 transition-all flex items-center gap-2"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"></polygon>
            </svg>
            Explore Projects
          </a>

          <a
            href="#about"
            class="px-5 py-2.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-750 text-slate-800 dark:text-white font-semibold text-xs sm:text-sm border border-slate-300 dark:border-slate-700 shadow-sm transition-all flex items-center gap-2 group"
          >
            <span>About & Background</span>
            <span class="text-emerald-500 group-hover:translate-x-0.5 transition-transform">→</span>
          </a>

          {profile.github && (
            <a
              href={profile.github}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub Profile"
              class="p-2.5 rounded-xl bg-white dark:bg-slate-800 hover:bg-slate-50 dark:hover:bg-slate-750 text-slate-700 dark:text-slate-300 border border-slate-300 dark:border-slate-700 shadow-sm transition-colors"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
            </a>
          )}
        </div>
      </div>

      {profile.avatar && (
        <div class="relative shrink-0">
          <div class="w-48 h-48 sm:w-56 sm:h-56 md:w-64 md:h-64 rounded-2xl overflow-hidden p-2 bg-gradient-to-tr from-emerald-500 via-teal-400 to-sky-500 shadow-xl shadow-emerald-500/10">
            <img
              src={profile.avatar}
              alt={profile.name}
              class="w-full h-full object-cover rounded-xl bg-slate-200 dark:bg-slate-800"
            />
          </div>
        </div>
      )}

    </div>
  </div>
</section>
