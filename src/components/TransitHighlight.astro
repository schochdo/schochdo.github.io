---
---

<section id="interactive-spotlights" class="py-16 md:py-24 bg-slate-100/70 dark:bg-slate-900/40 border-y border-slate-200/80 dark:border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950/60 text-emerald-800 dark:text-emerald-300 text-xs font-semibold uppercase tracking-wider mb-3 border border-emerald-200 dark:border-emerald-800/60 shadow-xs">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
        Interactive System Spotlights
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Full-Stack Geospatial Applications
      </h2>
      <p class="text-slate-600 dark:text-slate-400 mt-2 text-sm sm:text-base leading-relaxed">
        Bespoke interactive mapping platforms engineering automated data ingestion, real-time telemetry, and high-performance WebGL vector rendering across natural systems and complex networks.
      </p>
    </div>

    <!-- Dual Spotlight Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-10">
      
      <!-- Spotlight 1: Colorado River Basin Dashboard -->
      <div class="bg-gradient-to-br from-slate-900 to-slate-950 text-white rounded-3xl p-7 sm:p-8 border border-slate-800 shadow-2xl flex flex-col justify-between relative overflow-hidden group">
        <div class="absolute -right-16 -bottom-16 w-64 h-64 rounded-full bg-sky-500/10 blur-3xl pointer-events-none"></div>

        <div>
          <!-- Top Badge & Title -->
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-sky-500/20 text-sky-300 text-xs font-semibold border border-sky-500/30">
              <span>🌊</span> Environmental Hydrology
            </span>
            <span class="text-xs font-mono text-slate-400">MapLibre GL JS • Python</span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-white mb-3 tracking-tight">
            Colorado River Basin Water Infrastructure Dashboard
          </h3>

          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
            An automated spatial data pipeline and interactive situational awareness dashboard harmonizing streamflow, trans-mountain diversions, and reservoir storage across the Continental Divide.
          </p>

          <!-- Feature Bullets -->
          <ul class="space-y-2 mb-6 text-xs text-slate-300">
            <li class="flex items-start gap-2">
              <span class="text-sky-400 font-bold">✓</span>
              <span><strong>Multi-Agency Synthesis:</strong> Ingests live telemetry from USGS NWIS, USBR, and CDWR APIs.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-sky-400 font-bold">✓</span>
              <span><strong>Divide Diversions & Storage:</strong> Tracks 38 live telemetry nodes, 7 mega-reservoirs, and Front Range tunnels.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-sky-400 font-bold">✓</span>
              <span><strong>GPU Vector Canvas:</strong> Dynamic flow-weighted river widths on Esri National Geographic relief.</span>
            </li>
          </ul>

          <!-- Visual Preview Box -->
          <div class="rounded-xl overflow-hidden border border-slate-700/80 bg-slate-950 mb-6 relative aspect-[16/10]">
            <img
              src="/images/colorado_river_basin.png"
              alt="Colorado River Basin Hydrology Dashboard"
              class="w-full h-full object-cover object-top opacity-90 group-hover:scale-102 transition-transform duration-500"
              loading="lazy"
            />
            <button
              type="button"
              data-lightbox-trigger="/images/colorado_river_basin.png"
              data-lightbox-title="Colorado River Basin Water Infrastructure & Hydrology Dashboard"
              data-lightbox-desc="Real-time telemetry pipeline tracking Colorado River streamflow, Front Range trans-mountain diversions (Adams, Moffat, Roberts tunnels), and Lake Powell/Mead storage."
              class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-3 text-center cursor-pointer backdrop-blur-[2px]"
            >
              <span class="px-3.5 py-1.5 rounded-lg bg-slate-900/90 text-white border border-white/20 text-xs font-semibold shadow-lg flex items-center gap-1.5">
                <span>🔍</span> Inspect High-Res Interface
              </span>
            </button>
          </div>
        </div>

        <!-- Action Links -->
        <div class="pt-4 border-t border-slate-800 flex items-center justify-between gap-3 text-xs font-semibold">
          <a
            href="https://github.com/schochdo/CO_River"
            target="_blank"
            rel="noopener noreferrer"
            class="px-4 py-2 rounded-xl bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold transition-colors flex items-center gap-1.5"
          >
            <span>GitHub Repository</span>
            <span>↗</span>
          </a>
          <span class="text-slate-400 font-mono text-[11px]">Local Server / Active Pipeline</span>
        </div>
      </div>

      <!-- Spotlight 2: Real-Time Bustang Transit Stream -->
      <div class="bg-gradient-to-br from-slate-900 to-slate-950 text-white rounded-3xl p-7 sm:p-8 border border-slate-800 shadow-2xl flex flex-col justify-between relative overflow-hidden group">
        <div class="absolute -right-16 -bottom-16 w-64 h-64 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>

        <div>
          <!-- Top Badge & Title -->
          <div class="flex items-center justify-between gap-3 mb-4">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-semibold border border-emerald-500/30">
              <span>⚡</span> Real-Time Streaming Systems
            </span>
            <span class="text-xs font-mono text-slate-400">GTFS-RT • Leaflet • Render</span>
          </div>

          <h3 class="text-xl sm:text-2xl font-bold text-white mb-3 tracking-tight">
            Real-Time Vehicle Tracking & Transit Stream
          </h3>

          <p class="text-slate-300 text-xs sm:text-sm leading-relaxed mb-6">
            A real-time geospatial asset tracking application decoding live Protocol Buffer feeds across Colorado's statewide intercity network with sub-minute headway monitoring.
          </p>

          <!-- Feature Bullets -->
          <ul class="space-y-2 mb-6 text-xs text-slate-300">
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>Binary Protobuf Ingestion:</strong> Continuous decoding of GTFS-Realtime feeds for active vehicle coordinates.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>Cloud Microservice:</strong> Deployed live on Render with automated schedule adherence monitoring.</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>Open Mapping Stack:</strong> Lightweight Leaflet and OpenStreetMap rendering with zero vendor lock-in.</span>
            </li>
          </ul>

          <!-- Visual Preview Box -->
          <div class="rounded-xl overflow-hidden border border-slate-700/80 bg-slate-950 mb-6 relative aspect-[16/10]">
            <img
              src="/images/bustang_dashboard.png"
              alt="Bustang Real-Time Transit Dashboard"
              class="w-full h-full object-cover object-top opacity-90 group-hover:scale-102 transition-transform duration-500"
              loading="lazy"
            />
            <a
              href="https://transit-dashboard-ap50.onrender.com"
              target="_blank"
              rel="noopener noreferrer"
              class="absolute inset-0 bg-slate-950/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center p-3 text-center backdrop-blur-[2px]"
            >
              <span class="px-3.5 py-1.5 rounded-lg bg-emerald-500 text-slate-950 text-xs font-bold shadow-lg flex items-center gap-1.5">
                <span>🚀</span> Launch Live Render App ↗
              </span>
            </a>
          </div>
        </div>

        <!-- Action Links -->
        <div class="pt-4 border-t border-slate-800 flex items-center justify-between gap-3 text-xs font-semibold">
          <div class="flex items-center gap-2">
            <a
              href="https://transit-dashboard-ap50.onrender.com"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold transition-colors flex items-center gap-1.5"
            >
              <span>Launch Live App</span>
              <span>↗</span>
            </a>
            <a
              href="/bustang_leaflet/"
              class="px-3 py-2 rounded-xl bg-slate-800 hover:bg-slate-750 text-slate-300 transition-colors"
            >
              Standalone Map
            </a>
          </div>
          <a
            href="https://github.com/schochdo/schochdo.github.io"
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-400 hover:text-white transition-colors"
          >
            GitHub Code
          </a>
        </div>
      </div>

    </div>

  </div>
</section>
