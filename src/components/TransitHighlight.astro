---
---

<section id="transit-highlight" class="py-16 md:py-20 bg-slate-100/70 dark:bg-slate-900/40 border-y border-slate-200/80 dark:border-slate-800/80">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-slate-900 to-slate-950 text-white rounded-3xl p-8 sm:p-12 border border-slate-800 shadow-2xl overflow-hidden relative">
      
      <!-- Subtle decorative transit grid lines -->
      <div class="absolute -right-20 -bottom-20 w-96 h-96 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
        
        <!-- Left Column: Details -->
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/20 text-emerald-300 text-xs font-semibold uppercase tracking-wider mb-4 border border-emerald-500/30">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
            Real-Time Web GIS Application
          </div>

          <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-white mb-4">
            Colorado Bustang Live Transit Dashboard
          </h2>

          <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6">
            A full real-time transit intelligence dashboard and live interactive map tracking Colorado's statewide intercity bus network (Bustang, Outrider, Pegasus, and Snowstang), consuming live GTFS-RT feeds with OpenStreetMap basemaps and departure boards.
          </p>

          <!-- Feature Bullets -->
          <ul class="space-y-3 mb-8 text-xs sm:text-sm text-slate-300">
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>GTFS-Realtime Integration:</strong> Decodes live Protocol Buffer streams for active vehicle positions & headings.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>OpenStreetMap Basemap:</strong> Fast, reliable base layers with full OpenStreetMap and RTD license attributions.</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-400 font-bold">✓</span>
              <span><strong>Stop Search & Trends:</strong> Instant search for stops, departure estimates, and feed health monitoring.</span>
            </li>
          </ul>

          <!-- CTA Buttons -->
          <div class="flex flex-wrap items-center gap-3.5">
            <a
              href="https://transit-dashboard-ap50.onrender.com"
              target="_blank"
              rel="noopener noreferrer"
              class="px-6 py-3 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-sm shadow-lg shadow-emerald-500/20 transition-all flex items-center gap-2"
            >
              <span>Launch Live Dashboard</span>
              <span class="text-base leading-none">↗</span>
            </a>

            <a
              href="/bustang_leaflet/"
              class="px-5 py-3 rounded-xl bg-slate-800 hover:bg-slate-750 text-slate-200 font-semibold text-sm border border-slate-700 transition-colors flex items-center gap-1.5"
            >
              <span>Standalone Map</span>
              <span class="text-slate-400">(/bustang_leaflet/)</span>
            </a>

            <a
              href="https://github.com/schochdo/schochdo.github.io"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-3 rounded-xl text-slate-400 hover:text-white font-medium text-sm transition-colors"
            >
              GitHub Code
            </a>
          </div>
        </div>

        <!-- Right Column: Visual Preview -->
        <div class="lg:col-span-5">
          <div class="rounded-2xl overflow-hidden border border-slate-700/80 bg-slate-950/80 shadow-xl relative group">
            <div class="p-3 bg-slate-800/80 border-b border-slate-700 flex items-center justify-between text-xs text-slate-400">
              <div class="flex items-center gap-2">
                <span class="w-3 h-3 rounded-full bg-rose-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-amber-500/80 inline-block"></span>
                <span class="w-3 h-3 rounded-full bg-emerald-500/80 inline-block"></span>
                <span class="ml-2 font-mono text-[11px] text-slate-300">transit-dashboard-ap50.onrender.com</span>
              </div>
              <span class="text-emerald-400 font-medium">Live Render App</span>
            </div>

            <!-- Preview Image -->
            <div class="aspect-[4/3] bg-slate-900 relative overflow-hidden flex items-center justify-center">
              <img
                src="/images/bustang_dashboard.png"
                alt="Bustang Real-Time Transit Dashboard"
                class="w-full h-full object-cover object-top opacity-90 group-hover:scale-105 transition-transform duration-500"
              />
              <a
                href="https://transit-dashboard-ap50.onrender.com"
                target="_blank"
                rel="noopener noreferrer"
                class="absolute inset-0 bg-slate-950/50 flex flex-col items-center justify-center p-4 text-center group-hover:bg-slate-950/40 transition-colors"
              >
                <div class="w-14 h-14 rounded-2xl bg-emerald-500 text-slate-950 flex items-center justify-center shadow-xl mb-3">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                </div>
                <span class="text-white font-bold text-sm">Open Live Dashboard</span>
                <span class="text-slate-300 text-xs mt-1">Real-Time Colorado Bustang & Trends</span>
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
